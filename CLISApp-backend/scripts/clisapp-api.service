[Unit]
Description=CLISApp API Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/clisapp/CLISAPP/CLISApp-backend
Environment=PYTHONPATH=/opt/clisapp/CLISAPP/CLISApp-backend
EnvironmentFile=/opt/clisapp/CLISAPP/CLISApp-backend/.env
ExecStart=/opt/clisapp/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080 --workers 1
Restart=always
RestartSec=5
StandardOutput=append:/opt/clisapp/CLISAPP/CLISApp-backend/logs/api.log
StandardError=append:/opt/clisapp/CLISAPP/CLISApp-backend/logs/api.log

[Install]
WantedBy=multi-user.target
