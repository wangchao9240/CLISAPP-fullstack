[Unit]
Description=CLISApp Tiles Service
After=network.target clisapp-api.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/clisapp/CLISAPP/CLISApp-backend
Environment=PYTHONPATH=/opt/clisapp/CLISAPP/CLISApp-backend
EnvironmentFile=/opt/clisapp/CLISAPP/CLISApp-backend/.env
ExecStart=/opt/clisapp/venv/bin/uvicorn data_pipeline.servers.tile_server:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=append:/opt/clisapp/CLISAPP/CLISApp-backend/logs/tiles.log
StandardError=append:/opt/clisapp/CLISAPP/CLISApp-backend/logs/tiles.log

[Install]
WantedBy=multi-user.target
